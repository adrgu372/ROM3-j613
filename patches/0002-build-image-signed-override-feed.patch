+import hashlib
+import json
+import pathlib
+import sys
+import urllib.request
+manifest_file, feed, cache, versions_file = sys.argv[1:]
+manifest = json.loads(pathlib.Path(manifest_file).read_text())
+packages = manifest.get("packages")
+artifacts = manifest.get("artifacts")
+if not isinstance(packages, dict) or not packages:
+    raise SystemExit("ROM3 override manifest has no packages")
+if not isinstance(artifacts, list) or not artifacts:
+    raise SystemExit("ROM3 override manifest has no artifacts")
+cache_dir = pathlib.Path(cache)
+cache_dir.mkdir(parents=True, exist_ok=True)
+seen = set()
+for item in artifacts:
+    name = item.get("package")
+    version = item.get("version")
+    filename = item.get("file")
+    expected = item.get("sha256")
+    if packages.get(name) != version or not isinstance(filename, str):
+        raise SystemExit(f"invalid ROM3 override artifact: {name!r}")
+    if pathlib.Path(filename).name != filename or name in seen:
+        raise SystemExit(f"unsafe or duplicate ROM3 override artifact: {name}")
+    seen.add(name)
+    package = cache_dir / filename
+    for suffix in ("", ".sig"):
+        target = cache_dir / (filename + suffix)
+        if not target.exists():
+            urllib.request.urlretrieve(feed + "/" + filename + suffix, target)
+    actual = hashlib.sha256(package.read_bytes()).hexdigest()
+    if actual != expected:
+        raise SystemExit(f"ROM3 override SHA-256 mismatch: {filename}")
+if seen != set(packages):
+    raise SystemExit("ROM3 override packages and artifacts disagree")
+pathlib.Path(versions_file).write_text(
+    "".join(f"{name}\t{version}\n" for name, version in sorted(packages.items()))
+)
 PY
