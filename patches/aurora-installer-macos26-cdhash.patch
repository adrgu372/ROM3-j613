diff --git a/macOS/Packaging/build-app.sh b/macOS/Packaging/build-app.sh
index 8436458..6292883 100755
--- a/macOS/Packaging/build-app.sh
+++ b/macOS/Packaging/build-app.sh
@@ -401,7 +401,8 @@ codesign --force --sign "$signing_identity" "${timestamp_arguments[@]}" \
   --options runtime --identifier "$restore_image_identifier" "$restore_image_path"
 source "$script_directory/code-identity.sh"
 if [[ $signing_identity == "-" ]]; then
-  restore_image_requirement=$(installer_code_requirement "$restore_image_path" "$restore_image_identifier")
+  restore_image_requirement=$(installer_code_requirement "$restore_image_path" "$restore_image_identifier") \
