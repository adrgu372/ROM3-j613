+      bytes.append(
+        try JSONSerialization.data(withJSONObject: [
+          "schema_version": 1, "sequence": index + 1, "type": row.0, "payload": row.1,
+        ]))
+      bytes.append(10)
+    }
+    let inventory = try XCTUnwrap(
