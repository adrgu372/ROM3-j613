+          lengthBytes: 110 * gib, name: "Macintosh HD"),
+        NativeDiskLayout.Region(
+          kind: .free, offsetBytes: 110 * gib + 524_312_576,
+          lengthBytes: 35 * gib, name: "Free"),
+      ])
+    let display = try XCTUnwrap(
+      LiveInstallerEnvironment.layoutDisplay(layout, inventory: inventory))
+    XCTAssertEqual(display.options.map(\.kind), [.freeSpace])
+    XCTAssertEqual(display.options.first?.maximumBytes, 35 * gib)
+  }
