+      layoutDigest: "", systemStoreIdentifier: "disk0", candidates: [candidate])
+    let inventoryMessage = EngineInventoryMessage(
+      layoutDigest: unsigned.computedLayoutDigest,
+      systemStoreIdentifier: "disk0", candidates: [candidate])
