pkgname=rom3-j613-release
pkgver=1
pkgrel=3
pkgdesc='ROM3-j613 pacman repository configuration and release identity'
arch=('any')
url='https://github.com/adrgu372/ROM3-j613'
license=('custom')
source=('rom3-j613.conf' 'rom3-j613-mirrorlist')
sha256sums=(
  '89dc56a4ce6e9f02cab3a493c6c1eb6b2a0ee37457a2465614dbe21c330aa15d'
  '961b64129d9dd3aa45bd38bd1cad934ef17ccc173529c09d32d47b3aad7e7cb6'
)
options=('!strip')

package() {
  # Runtime-only dependencies: the local release package is built before the
  # guard and meta packages are installed.
  depends=('pacman' 'rom3-j613-guard' 'rom3-j613-meta' 'rom3-j613-keyring')
  install -Dm644 rom3-j613.conf \
    "$pkgdir/etc/pacman.d/rom3-j613.conf"
  install -Dm644 rom3-j613-mirrorlist \
    "$pkgdir/etc/pacman.d/rom3-j613-mirrorlist"
  install -Dm644 /dev/null \
    "$pkgdir/usr/share/rom3-j613/release-package"
}

