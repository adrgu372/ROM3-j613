options=('!strip')

check() {
  local root
  root=$(mktemp -d)
  trap 'rm -rf "$root"' EXIT

  ROM3_IDENTITY_ROOT="$root" ROM3_IDENTITY_TEMPLATE_DIR="$srcdir" \
    bash "$srcdir/set-os-identity"

  grep -qx 'NAME="ROM3"' "$root/etc/os-release"
  grep -qx 'PRETTY_NAME="ROM3"' "$root/etc/os-release"
  grep -qx 'ID=rom3' "$root/etc/os-release"
  grep -qx 'VARIANT_ID="j613"' "$root/etc/os-release"
  grep -qx 'NAME="ROM3"' "$root/usr/lib/os-release"
  grep -qx 'ID=rom3' "$root/usr/lib/os-release"
  grep -qx 'DISTRIB_ID=ROM3' "$root/etc/lsb-release"
  grep -qxF 'ROM3 \r (\l)' "$root/etc/issue"
}

package() {
  # Runtime-only dependencies: the local release package is built before the
  # guard and meta packages are installed.
  depends=('pacman' 'rom3-j613-guard' 'rom3-j613-meta' 'rom3-j613-keyring')
  install -Dm644 rom3-j613.conf \
    "$pkgdir/etc/pacman.d/rom3-j613.conf"
  install -Dm644 rom3-j613-mirrorlist \
    "$pkgdir/etc/pacman.d/rom3-j613-mirrorlist"
  install -Dm644 os-release \
    "$pkgdir/usr/share/rom3-j613/os-release"
  install -Dm644 lsb-release \
    "$pkgdir/usr/share/rom3-j613/lsb-release"
  install -Dm644 issue \
    "$pkgdir/usr/share/rom3-j613/issue"
  install -Dm755 set-os-identity \
    "$pkgdir/usr/libexec/rom3-j613/set-os-identity"
  install -Dm644 95-rom3-j613-os-identity.hook \
    "$pkgdir/usr/share/libalpm/hooks/95-rom3-j613-os-identity.hook"
  install -Dm644 /dev/null \
    "$pkgdir/usr/share/rom3-j613/release-package"
}

