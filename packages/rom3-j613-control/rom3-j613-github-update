#!/usr/bin/python3
"""Discover and install the newest signed ROM3-j613 override release."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.request

REPOSITORY = "adrgu372/ROM3-j613"
FINGERPRINT = "FA80FF234BCDF36211649321EB9845C8BAA89A4A"
KEY_URL = (
    "https://raw.githubusercontent.com/adrgu372/ROM3-j613/main/"
    "repo/keys/rom3-j613-packages.pub"
)
RELEASES_URL = (
    f"https://api.github.com/repos/{REPOSITORY}/releases?per_page=100"
)
CONFIG = Path(
    os.environ.get(
        "ROM3_AUTO_UPDATE_CONFIG", "/etc/rom3-j613/auto-update.conf"
    )
)
TIMER = "rom3-j613-github-update.timer"
UPDATE = "/usr/bin/rom3-j613-update"
OVERRIDE = "/usr/bin/rom3-j613-override"
REQUIRED_ASSETS = {
    "rom3-overrides.json",
    "rom3-overrides.json.sig",
    "rom3-j613-overrides.db.tar.zst",
    "rom3-j613-overrides.db.tar.zst.sig",
    "SHA256SUMS",
    "SHA256SUMS.sig",
}
TAG_RE = re.compile(r"^override-([0-9]{8})\.([0-9]+)$")
LEGACY_RE = re.compile(r"aura|aurora", re.IGNORECASE)


class NoCompatibleOverride(RuntimeError):
    pass


def require_root() -> None:
    if os.geteuid() != 0:
        raise SystemExit("rom3-j613-github-update must run as root")


def run(command: list[str]) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, check=True)


def fetch_json(url: str) -> object:
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "ROM3-j613-control-center",
        },
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.load(response)


def latest_override() -> str:
    releases = fetch_json(RELEASES_URL)
    if not isinstance(releases, list):
        raise SystemExit("GitHub returned an invalid release list")

    candidates: list[tuple[tuple[int, int], str]] = []
    for release in releases:
        if not isinstance(release, dict):
            continue
        tag = release.get("tag_name")
        match = TAG_RE.fullmatch(tag or "")
        if not match:
            continue
        assets = {
            item.get("name")
            for item in release.get("assets", [])
            if isinstance(item, dict)
        }
        if not REQUIRED_ASSETS.issubset(assets):
            continue
        manifest_url = (
            f"https://github.com/{REPOSITORY}/releases/download/"
            f"{tag}/rom3-overrides.json"
        )
        try:
            manifest = fetch_json(manifest_url)
        except (OSError, urllib.request.URLError):
            continue
        packages = (
            manifest.get("packages")
            if isinstance(manifest, dict)
            else None
        )
        if not isinstance(packages, dict) or not packages:
            continue
        if any(
            not isinstance(name, str) or LEGACY_RE.search(name)
            for name in packages
        ):
            continue
        candidates.append(
            (
                (int(match.group(1)), int(match.group(2))),
                tag,
            )
        )

    if not candidates:
        raise NoCompatibleOverride(
            "No compatible signed ROM3 override release is available. "
            "The published overrides still use legacy Aurora package names."
        )
    return max(candidates)[1]


def configure_override(tag: str) -> str:
    feed = (
        f"https://github.com/{REPOSITORY}/releases/download/{tag}"
    )
    run(
        [
            OVERRIDE,
            "configure",
            "--feed",
            feed,
            "--fingerprint",
            FINGERPRINT,
            "--key",
            KEY_URL,
        ]
    )
    return feed


def update(apply: bool) -> None:
    if apply:
        run([UPDATE, "--preflight-apply"])
    try:
        tag = latest_override()
    except NoCompatibleOverride as error:
        print(error, file=sys.stderr, flush=True)
        if apply:
            raise SystemExit(1)
        print("No signed protected-package update is available.")
        return
    print(f"Latest signed ROM3 override: {tag}", flush=True)
    feed = configure_override(tag)
    mode = "--apply-approved" if apply else "--check-approved"
    run([UPDATE, mode])
    print(f"ROM3 feed: {feed}", flush=True)
    if apply and Path("/etc/default/update-m1n1").is_file():
        guard = Path("/etc/default/update-m1n1").read_text(
            encoding="utf-8", errors="replace"
        )
        if re.search(r"^M1N1_UPDATE_DISABLED=1\\s*$", guard, re.MULTILINE):
            print(
                "WARNING: Stage 2 updates are disabled. If this transaction "
                "changed kernel, bootloader, U-Boot or userpages, prepare and test "
                "a Stage 2 candidate before rebooting.",
                file=sys.stderr,
                flush=True,
            )


def auto_enabled() -> bool:
    if not CONFIG.is_file():
        return False
    for line in CONFIG.read_text(encoding="utf-8").splitlines():
        if line.strip() == "AUTO_UPDATE=1":
            return True
    return False


def set_auto(enabled: bool) -> None:
    require_root()
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        prefix=".auto-update.", dir=CONFIG.parent, delete=False
    ) as stream:
        temporary = Path(stream.name)
        stream.write(
            b"AUTO_UPDATE=1\n" if enabled else b"AUTO_UPDATE=0\n"
        )
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, 0o644)
    os.replace(temporary, CONFIG)
    if enabled:
        run(["systemctl", "enable", "--now", TIMER])
        print("Automatic ROM3 updates enabled.")
    else:
        run(["systemctl", "disable", "--now", TIMER])
        print("Automatic ROM3 updates disabled.")


def auto_update() -> None:
    require_root()
    if not auto_enabled():
        print("Automatic ROM3 updates are disabled.")
        return
    lock_path = Path("/run/lock/rom3-j613-github-update.lock")
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another ROM3 GitHub update is already running.")
            return
        update(True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Install the latest signed ROM3-j613 GitHub release"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--check", action="store_true")
    group.add_argument("--apply", action="store_true")
    group.add_argument("--auto", action="store_true")
    group.add_argument("--set-auto", choices=("on", "off"))
    args = parser.parse_args()

    require_root()
    if args.set_auto:
        set_auto(args.set_auto == "on")
    elif args.auto:
        auto_update()
    else:
        update(args.apply)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        if error.returncode == 75:
            print(
                "GitHub update cancelled: insufficient free space. "
                "No packages were changed.",
                file=sys.stderr,
            )
        elif error.returncode == 74:
            print(
                "GitHub update cancelled: the configured swapfile is "
                "missing, empty, truncated or inactive. No packages were changed.",
                file=sys.stderr,
            )
        else:
            print(
                f"GitHub update failed with exit {error.returncode}",
                file=sys.stderr,
            )
        raise SystemExit(error.returncode or 1)
    except (OSError, urllib.request.URLError) as error:
        print(f"GitHub update failed: {error}", file=sys.stderr)
        raise SystemExit(1)
