#!/bin/bash
set -euo pipefail

quarantine=${ROM3_QUARANTINE:-/usr/share/rom3-j613/quarantine.packages}
override_manifest=${ROM3_OVERRIDE_MANIFEST:-/var/lib/rom3-j613/override/manifest.json}
pacman_conf=${ROM3_PACMAN_CONF:-/etc/pacman.conf}
mode=${1:---check}
apply_mode=false
safe_mode=false
approved_mode=false

if (( EUID != 0 )); then
    echo "rom3-j613-update must run as root" >&2
    exit 1
fi

case $mode in
    --check|--apply) ;;
    --check-safe|--apply-safe) safe_mode=true ;;
    --check-approved|--apply-approved) approved_mode=true ;;
    *)
        echo "usage: rom3-j613-update [--check|--apply|--check-safe|--apply-safe|--check-approved|--apply-approved]" >&2
        exit 2
        ;;
esac
[[ $mode != --apply && $mode != --apply-safe && $mode != --apply-approved ]] ||
    apply_mode=true

[[ -r $quarantine ]] || {
    echo "missing quarantine list: $quarantine" >&2
    exit 1
}

pacman -Sy --noconfirm

pending=$(mktemp)
pending_details=$(mktemp)
blocked=$(mktemp)
approved=$(mktemp)
approved_pending=$(mktemp)
quarantine_sorted=$(mktemp)
ordinary_pending=$(mktemp)
pacman_config=
swapfile=${ROM3_SWAPFILE:-/swap/swapfile}
swapfile_kib=
swapfile_active=false

restore_swapfile() {
    $swapfile_active || return 0
    if [[ ! -e $swapfile ]]; then
        [[ -n $swapfile_kib ]] || {
            echo "cannot restore swapfile: $swapfile is missing" >&2
            return 1
        }
        btrfs filesystem mkswapfile --size "${swapfile_kib}K" "$swapfile"
        chmod 600 "$swapfile"
    fi
    systemctl reset-failed swap-swapfile.swap 2>/dev/null || true
    systemctl start swap-swapfile.swap || swapon "$swapfile"
    swapfile_active=false
}

cleanup() {
    restore_swapfile || true
    rm -f "$pending" "$pending_details" "$blocked" "$approved" \
        "$approved_pending" "$quarantine_sorted" "$ordinary_pending"
    [[ -z $pacman_config ]] || rm -f "$pacman_config"
}
trap cleanup EXIT

pacman -Qu 2>/dev/null |
    awk 'NF {print $1 "\t" $NF}' > "$pending_details" || true
cut -f1 "$pending_details" | LC_ALL=C sort -u > "$pending"
LC_ALL=C sort -u "$quarantine" > "$quarantine_sorted"
LC_ALL=C comm -23 "$pending" "$quarantine_sorted" > "$ordinary_pending"

if ! $safe_mode && [[ -f $override_manifest ]]; then
    python3 - "$override_manifest" > "$approved" <<'PY'
import json
import re
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
if (
    manifest.get("schema_version") != 1
    or manifest.get("distribution") != "ROM3-j613"
    or not isinstance(manifest.get("packages"), dict)
):
    raise SystemExit("invalid active override manifest")
for name, version in sorted(manifest["packages"].items()):
    if not re.fullmatch(r"[a-z0-9@._+:-]+", name):
        raise SystemExit(f"invalid package name in override: {name!r}")
    if re.search(r"aura|aurora", name, re.IGNORECASE):
        continue
    if not isinstance(version, str) or not re.fullmatch(
        r"[A-Za-z0-9@._+~:-]+", version
    ):
        raise SystemExit(f"invalid version in override for {name}")
    print(f"{name}\t{version}")
PY
fi

while IFS=$'\t' read -r package available_version; do
    [[ -n $package ]] || continue
    grep -qx "$package" "$quarantine_sorted" || continue
    expected_version=$(awk -F'\t' -v name="$package" \
        '$1 == name {print $2; exit}' "$approved")
    if [[ -n $expected_version && $available_version == "$expected_version" ]]; then
        printf '%s\t%s\n' "$package" "$available_version" >> "$approved_pending"
    else
        printf '%s\n' "$package" >> "$blocked"
    fi
done < "$pending_details"

if [[ -s $blocked ]] && ! $safe_mode && ! $approved_mode; then
    echo "ROM3-j613: unqualified updates blocked:" >&2
    sed 's/^/  - /' "$blocked" >&2
    echo >&2
    echo "Publish a newly tested stack before changing these packages." >&2
    exit 1
fi

if [[ ! -s $pending ]]; then
    echo "ROM3-j613: no pending package updates."
    exit 0
fi

if { $safe_mode || $approved_mode; } && [[ -s $blocked ]]; then
    echo "ROM3-j613: protected packages held at their tested versions:"
    sed 's/^/  - /' "$blocked"
    echo
fi

if $safe_mode && [[ ! -s $ordinary_pending ]]; then
    echo "ROM3-j613: no non-protected package updates are available."
    exit 0
fi

if $approved_mode && [[ ! -s $ordinary_pending && ! -s $approved_pending ]]; then
    echo "ROM3-j613: no safe or signed-override package updates are available."
    exit 0
fi

echo "Proposed non-quarantined updates:"
while IFS= read -r package; do
    grep -qx "$package" "$blocked" && continue
    expected_version=$(awk -F'\t' -v name="$package" \
        '$1 == name {print $2; exit}' "$approved_pending")
    if [[ -n $expected_version ]]; then
        printf '%s (approved by override: %s)\n' "$package" "$expected_version"
    else
        pacman -Qu "$package" || true
    fi
done < "$pending"

if ! $apply_mode; then
    echo
    if $safe_mode; then
        echo "ROM3-j613: safe check complete; protected packages will not be changed."
    elif $approved_mode; then
        echo "ROM3-j613: approved check complete; only signed override packages and ordinary packages will change."
    elif [[ -s $approved_pending ]]; then
        echo "ROM3-j613: all quarantined changes are approved by the active override."
    else
        echo "ROM3-j613: no quarantined package would change."
    fi
    exit 0
fi

stamp=$(date +%Y%m%d-%H%M%S)
backup=/var/backups/rom3-j613/$stamp
install -d -m700 "$backup"

snapshot_root=${ROM3_SNAPSHOT_ROOT:-/var/lib/rom3-j613/snapshots}
root_fstype=$(findmnt -nro FSTYPE --target /)
if [[ $root_fstype != btrfs ]]; then
    echo "ROM3 requires a Btrfs root for pre-update snapshots." >&2
    exit 1
fi

install -d -m755 "$snapshot_root"

# Btrfs refuses to snapshot a subvolume with an active swapfile. Snapshot
# first, then replace the old swapfile with an independent one and re-enable
# it. Keeping swap disabled until the snapshot is removed would be unsafe on
# a 16 GiB machine, and the old file remains recoverable from the snapshot.
if [[ -f $swapfile ]] &&
    awk -v file="$swapfile" '$1 == file && $2 == "file" { found = 1 } END { exit !found }' \
        /proc/swaps; then
    swapfile_size=$(stat -c %s "$swapfile")
    swapfile_kib=$(((swapfile_size + 1023) / 1024))
    swapfile_active=true
    echo "Temporarily disabling $swapfile for the Btrfs snapshot..."
    if systemctl cat swap-swapfile.swap >/dev/null 2>&1; then
        systemctl stop swap-swapfile.swap
    else
        swapoff "$swapfile"
    fi
fi

btrfs subvolume snapshot -r / "$snapshot_root/$stamp"

if $swapfile_active; then
    rm -f -- "$swapfile"
    btrfs filesystem mkswapfile --size "${swapfile_kib}K" "$swapfile"
    chmod 600 "$swapfile"
    systemctl reset-failed swap-swapfile.swap 2>/dev/null || true
    systemctl start swap-swapfile.swap || swapon "$swapfile"
    swapfile_active=false
    echo "Swapfile recreated independently of the snapshot and enabled."
fi

[[ ! -e /boot/efi/m1n1/boot.bin ]] ||
    cp -a /boot/efi/m1n1/boot.bin "$backup/boot.bin"
[[ ! -e /etc/m1n1.conf ]] ||
    cp -a /etc/m1n1.conf "$backup/m1n1.conf"
[[ ! -e /etc/default/update-m1n1 ]] ||
    cp -a /etc/default/update-m1n1 "$backup/update-m1n1"

pacman -Q > "$backup/packages.before"
sha256sum "$backup"/boot.bin > "$backup/boot.bin.sha256" 2>/dev/null || true

echo "Backup: $backup"
echo "Btrfs snapshot: $snapshot_root/$stamp"
if $safe_mode; then
    echo "Starting safe upgrade; protected ROM3 packages remain pinned..."
elif $approved_mode; then
    echo "Starting signed update; only override-approved protected packages may change..."
else
    echo "Starting full upgrade with only signed override versions admitted..."
fi

pacman_config=$(mktemp)
cp -a "$pacman_conf" "$pacman_config"
python3 - "$pacman_config" "$approved" "$quarantine_sorted" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
approved = {
    line.split("\t", 1)[0]
    for line in Path(sys.argv[2]).read_text().splitlines()
    if line
}
quarantine = {
    line.strip()
    for line in Path(sys.argv[3]).read_text().splitlines()
    if line.strip()
}
held = quarantine - approved
lines = path.read_text().splitlines()
in_options = False
ignore_at = None
for index, line in enumerate(lines):
    stripped = line.strip()
    if stripped == "[options]":
        in_options = True
        continue
    if in_options and stripped.startswith("[") and stripped.endswith("]"):
        break
    if in_options and stripped.startswith("IgnorePkg"):
        ignore_at = index
        held.update(line.partition("=")[2].split())
        break
replacement = ["IgnorePkg = " + " ".join(sorted(held))] if held else []
if ignore_at is None:
    options_at = lines.index("[options]")
    lines[options_at + 1:options_at + 1] = replacement
else:
    lines[ignore_at:ignore_at + 1] = replacement
path.write_text("\n".join(line for line in lines if line != "") + "\n")
PY

targets=()
while IFS=$'\t' read -r package version; do
    [[ -n $package ]] || continue
    targets+=("$package=$version")
done < "$approved"
pacman -Syu --config "$pacman_config" "${targets[@]}"
rom3-j613-check

echo
echo "Update complete. After the next boot, run:"
echo "  /usr/share/rom3-j613/verify-live-system.sh"

