#!/usr/bin/env python3
"""Verify that the installed packages match the ROM3-j613 tested stack."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys

STACK = Path(
    os.environ.get(
        "ROM3_VERIFIED_STACK",
        "/usr/share/rom3-j613/verified-stack.json",
    )
)
OVERRIDE_MANIFEST = Path(
    os.environ.get(
        "ROM3_OVERRIDE_MANIFEST",
        "/var/lib/rom3-j613/override/manifest.json",
    )
)
OS_RELEASE = Path(
    os.environ.get("ROM3_OS_RELEASE", "/etc/os-release")
)


def installed() -> dict[str, str]:
    output = subprocess.check_output(["pacman", "-Q"], text=True)
    return dict(line.split(maxsplit=1) for line in output.splitlines())


def identity() -> dict[str, str]:
    result = {}
    for line in OS_RELEASE.read_text().splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        result[key] = value.strip().strip('"')
    return result


def main() -> int:
    stack = json.loads(STACK.read_text())
    expected = stack["packages"]
    legacy = set(stack.get("legacy_packages", {}))
    if OVERRIDE_MANIFEST.is_file():
        override = json.loads(OVERRIDE_MANIFEST.read_text())
        if (
            override.get("schema_version") != 1
            or override.get("distribution") != "ROM3-j613"
            or not isinstance(override.get("packages"), dict)
        ):
            print(
                f"invalid override manifest: {OVERRIDE_MANIFEST}",
                file=sys.stderr,
            )
            return 1
        ignored = sorted(legacy & override["packages"].keys())
        expected.update(
            {
                name: version
                for name, version in override["packages"].items()
                if name not in legacy
            }
        )
        print(f"using override feed based on {override.get('base_snapshot')}")
        if ignored:
            print("ignoring legacy override entries: " + " ".join(ignored))
    current = installed()
    failures = 0
    current_identity = identity()

    for key, expected_value in {
        "NAME": "ROM3",
        "ID": "rom3",
        "ID_LIKE": "arch",
        "VARIANT_ID": "j613",
    }.items():
        actual_value = current_identity.get(key)
        if actual_value == expected_value:
            print(f"ok       os-release {key}={expected_value}")
        else:
            failures += 1
            print(
                f"MISMATCH os-release {key}: expected {expected_value}, "
                f"found {actual_value or 'missing'}"
            )

    for name, version in expected.items():
        actual = current.get(name)
        if actual == version:
            print(f"ok       {name} {version}")
        else:
            failures += 1
            print(f"MISMATCH {name}: expected {version}, found {actual or 'missing'}")

    if failures:
        print(f"\nROM3 check failed: {failures} mismatches", file=sys.stderr)
        return 1

    print("\nInstalled package set matches ROM3-j613.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

