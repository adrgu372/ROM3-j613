+/*
+ * A low-window SIO (M1, M2) takes the earlier boot tables when its firmware
+ * reports protocol 9 and T6030's when it reports protocol 10. The boot
+ * loader passes the protocol-10 tables as a second list. Validate both
+ * candidates before sending one; if neither works, keep firmware available
+ * for sleep but expose no DMA service.
+ */
+static const char *sio_dt_params_name(struct sio_data *sio)
+{
+	struct device_node *np = sio->dev->of_node;
+
+	if (sio->protocol != 10)
+		return "apple,sio-firmware-params";
+	if (!sio_t6030_check_node(np, "apple,sio-firmware-params-v10"))
+		return "apple,sio-firmware-params-v10";
+	if (!sio_t6030_check_node(np, "apple,sio-firmware-params"))
+		return "apple,sio-firmware-params";
+
+	sio->tables_mismatch = true;
+	return NULL;
+}
