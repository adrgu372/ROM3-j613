pkgname=alsa-ucm-conf-rom3
pkgver=10.aurora2
pkgrel=5
pkgdesc='ROM3 Apple Silicon ALSA profiles including J700'
arch=('any')
groups=('rom3-platform-apple-silicon')
url='https://github.com/aurora-silicon/alsa-ucm-conf-asahi'
license=('BSD-3-Clause')
_commit=96b3206d2f4c6f89145a2f1b5395a833fb2ae0af
makedepends=('git')
depends=('alsa-ucm-conf')
provides=("alsa-ucm-conf-asahi=$pkgver" "alsa-ucm-conf-asahi-aurora=$pkgver"
          "alsa-ucm-conf-rom3=$pkgver-$pkgrel")
conflicts=('alsa-ucm-conf-asahi' 'alsa-ucm-conf-asahi-aurora' 'alsa-ucm-conf-rom3')
replaces=('alsa-ucm-conf-asahi-aurora' 'alsa-ucm-conf-rom3')
source=("ucm::git+$url.git#commit=$_commit")
sha256sums=('89c32e3bcc30288d7077fed0ccb242e82e933ab5380ea6f3d0a5165a9b35ad36')
package() {
  install -d "$pkgdir/usr/share/alsa"
  cp -a ucm/ucm2 "$pkgdir/usr/share/alsa/"
  install -Dm644 ucm/LICENSE.asahi "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
