package() {
  local size
  for size in 16 22 24 32 48 64 96 128 256 512; do
    install -Dm644 "ROM3Logo-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rom3-logo-icon.png"
    install -Dm644 "ROM3Logo-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/places/start-here.png"
  done
  install -Dm644 ROM3Logo-256.png "$pkgdir/usr/share/pixmaps/rom3-logo.png"
  install -Dm644 ROM3Logo-256.png "$pkgdir/usr/share/pixmaps/system-logo-white.png"
  install -Dm644 kcm-about-distrorc "$pkgdir/etc/xdg/kcm-about-distrorc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 provenance.json "$pkgdir/usr/share/doc/$pkgname/provenance.json"
}
