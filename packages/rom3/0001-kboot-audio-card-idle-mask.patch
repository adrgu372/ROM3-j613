+    if name == "card-masks-agree-t8122":
+        return adt(group), dts(three, card=([0x40, 0x41, 0x42], {0: z0, 1: z1}),
+                               compatible=["apple,j613", "apple,t8122", "apple,arm-platform"])
+    if name == "card-masks-two-links-disagree":
