# ROM3 bootloader, downstream of Aura; ordinary updates refresh ESP Stage 2,
# never enroll Stage 1.
pkgname=rom3
pkgver=1.0.0b17
pkgrel=2
pkgdesc='ROM3 Apple Silicon bootloader'
arch=('aarch64')
groups=('rom3-platform-apple-silicon')
url='https://github.com/aurora-silicon/aura'
license=('MIT' 'GPL-2.0-only')
_commit=5a244b5bcbaf4a2751abea18dc0dd8e71c325e46
# 1 once the pinned source has no monitor (aura#77); prepare() checks it. Such an
# the bootloader moves the kernel into the CTXR window, so it requires a kernel
# built with CONFIG_ARM64_CTXR_EXECMEM, which linux-rom3 provides.
_monitor_free=1
_ctxr_kernel=()
if (( _monitor_free )); then _ctxr_kernel=('rom3-ctxr-execmem'); fi
_compat=1.6.1.aurora19
provides=("m1n1=$_compat" "m1n1-aurora=$_compat" "m1n1-neo=$_compat"
          "aura=$pkgver-$pkgrel")
conflicts=('m1n1' 'm1n1-aurora' 'm1n1-neo' 'aura')
replaces=('m1n1-neo' 'aura')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
source=("aura::git+$url.git#commit=$_commit" build-qualification.json validate-qualification.py
        0001-kboot-audio-card-idle-mask.patch
        rom3_source.png rom3_48.bin rom3_128.bin rom3_256.bin)
sha256sums=('SKIP' '666fc8adaaec5708ce433d8dafc684a75376df90c1fcaf1d393cc41f3676b03b' 'd89f89a68105e4663bdf14bf9d4d70f3fad79538a4c566e8fae73c0b40a9be26'
            '42ef14cebc0d06bb09781a297799fe30830953ecd14cf1e5164cf048ed45f0c2'
            '6ccdbad376038dcd2db2f45683fa7ef7e61a381d7e56c99c6053bc2224b1c93a'
            'ffa0942996f3f50f02093aa1e2eba4c9eda80490905fcccbae6887ba3f085418'
            '9403ea6847b553518f0ed1e7055fe6d14ca2348b74a30255b1f052a9eaa95c3f'
            '4258db69fcc9b090b800a8242b377c0d371122dc43e25075eeafb2c573c4707c')
prepare() {
  rustup toolchain install 1.99.0 --profile minimal --target aarch64-unknown-none-softfloat
  [[ $(git -C aura rev-parse HEAD) == "$_commit" ]]
  python3 ../validate-qualification.py --build-only ../build-qualification.json "$_commit"
  patch -Np1 -d aura < "../0001-kboot-audio-card-idle-mask.patch" || { echo "0001-kboot-audio-card-idle-mask.patch did not apply" >&2; return 1; }
  local found=0
  if [[ -f aura/src/ctxr_exec.c || ! -f aura/src/monitor.c ]]; then found=1; fi
  if (( found != _monitor_free )); then
    echo "rom3: set _monitor_free=$found, which the pinned source is" >&2
    return 1
  fi
}
check() {
  cd aura
  output=$(RUSTUP_TOOLCHAIN=1.99.0 sh tests/run-kboot-audio.sh)
  printf '%s\n' "$output"
  grep -q 'kboot audio: 47 scenarios pass' <<<"$output"
}

build() {
  cd aura
  export RUSTUP_TOOLCHAIN=1.99.0
  # The pin is not a release tag: label the build <VERSION>-g<commit>, as the
  # Fedora and NixOS archive builds do (a tagged pin is labelled with its release).
  export AURA_VERSION_TAG="$(cat VERSION)-g${_commit:0:8}"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 USE_CLANG=1 \
    BUILTIN_LOGO=rom3 LOGO_DIR="$srcdir"
  install -Dm644 build/aura.bin "$srcdir/stage1/aura-raw.bin"
  install -Dm644 build/aura.macho "$srcdir/stage1/aura.macho"
  install -Dm644 build/aura-boot.macho "$srcdir/stage1/aura-boot.macho"
  make clean
  # The secure-flavour Stage 1 that aurora-secboot stage1 build fills with the
  # owner's key. Its built-in key, used only while the key block is unfilled, is a
  # fresh one whose private half is never written down, so an unfilled image
  # verifies nothing.
  python3 -c 'import os, sys; sys.path.insert(0, "tools"); import secboot_sign; sys.stdout.buffer.write(secboot_sign.pubkey(os.urandom(32)))' > "$srcdir/stage1/nobody.pub"
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 USE_CLANG=1 \
    BUILTIN_LOGO=rom3 LOGO_DIR="$srcdir" \
    SECBOOT=audit SECBOOT_FLAVOUR=secure SECBOOT_PUBKEY="$srcdir/stage1/nobody.pub"
  install -Dm644 build/aura.bin "$srcdir/stage1/aura-secure-raw.bin"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1 USE_CLANG=1 \
    BUILTIN_LOGO=rom3 LOGO_DIR="$srcdir"
}
package() {
  # Required on the installed system, not to build the bootloader. A Mach-O Mac
  # needs the update-m1n1 that leaves boot.bin alone, or this bootloader could
  # overwrite it. New images reach Stage 2 through update-m1n1's trial support.
  depends=('asahi-scripts>=20260127.1' 'aurora-stage2-ctxr-slot' 'aurora-stage2-trial' 'uboot-rom3' "${_ctxr_kernel[@]}")
  # Building a PR candidate does not assert release/hardware qualification.
  install -Dm644 aura/build/aura.bin "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -d "$pkgdir/usr/lib/m1n1-neo"
  ln -s ../asahi-boot/m1n1.bin "$pkgdir/usr/lib/m1n1-neo/m1n1.bin"
  # An aura without the monitor: update-m1n1 then stops writing boot.bin on Mach-O Macs.
  if (( _monitor_free )); then
    install -Dm644 /dev/null "$pkgdir/usr/share/aura/monitor-free"
  fi
  install -Dm644 stage1/aura-raw.bin "$pkgdir/usr/share/aura/stage1/aura-raw.bin"
  install -Dm644 stage1/aura-boot.macho "$pkgdir/usr/share/aura/stage1/aura-boot.macho"
  install -Dm644 stage1/aura.macho "$pkgdir/usr/share/aura/stage1/aura.macho"
  install -Dm644 stage1/aura-secure-raw.bin "$pkgdir/usr/share/aura/stage1/aura-secure-raw.bin"
  # aura's own Stage 1 and signing tools, for aurora-secboot stage1 build and stage2 sign.
  local tool
  for tool in fill_stage1_config.py secboot_sign.py macho_boot_object.py; do
    install -Dm644 "aura/tools/$tool" "$pkgdir/usr/share/aura/tools/$tool"
  done
  install -Dm644 aura/tools/recovery/enroll-stage1.sh "$pkgdir/usr/share/aura/tools/enroll-stage1.sh"
  install -Dm644 aura/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 aura/3rdparty_licenses/* "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$srcdir/build-qualification.json" "$pkgdir/usr/share/doc/aura/build-qualification.json"
}
